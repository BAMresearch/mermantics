    Treatment -. "parent of" .-> Sample2
    Treatment -. "parent of" .-> Sample3
    Char1 -. "has dataset" .-> DataChar1
    Sample3 -. "parent of" .-> Char2
    Sample2 -. "parent of" .-> ExperimentalStep
    ExperimentalStep -. "has dataset" .-> Dataset

