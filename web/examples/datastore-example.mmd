%% The example from the BAM Data Store guide "Represent research data in the Data Store":
%% material synthesis and characterization. Arrows go from parent to child; datasets hang off
%% the experimental step that made them.

    Synthesis["<b>Material synthesis</b><br>Object type: EXPERIMENTAL_STEP<br>In: Lab Notebook<br>Space: Home space (FB username)<br>Project: Material synthesis and characterization<br>Collection: Experimental Steps"]:::dsdo
    Treatment["<b>Material treatment</b><br>Object type: EXPERIMENTAL_STEP<br>In: Lab Notebook<br>Space: Home space (FB username)<br>Project: Material synthesis and characterization<br>Collection: Experimental Steps"]:::dsdo
    Char1["<b>Characterization parameter 1</b><br>Object type: EXPERIMENTAL_STEP<br>In: Lab Notebook<br>Space: Home space (FB username)<br>Project: Material synthesis and characterization<br>Collection: Experimental Steps"]:::dsdo
    Char2["<b>Characterization parameter 2</b><br>Object type: EXPERIMENTAL_STEP<br>In: Lab Notebook<br>Space: Home space (FB username)<br>Project: Material synthesis and characterization<br>Collection: Experimental Steps"]:::dsdo
    Analysis2["<b>Data analysis parameter 2</b><br>Object type: EXPERIMENTAL_STEP<br>In: Lab Notebook<br>Space: Home space (FB username)<br>Project: Material synthesis and characterization<br>Collection: Experimental Steps"]:::dsdo

    Chemical1["<b>Chemical 1</b><br>Object type: CHEMICAL<br>In: FB-Inventory<br>Space: MATERIALS<br>Project: CONSUMABLES<br>Collection: Chemicals"]:::dsuse
    Chemical2["<b>Chemical 2</b><br>Object type: CHEMICAL<br>In: FB-Inventory<br>Space: MATERIALS<br>Project: CONSUMABLES<br>Collection: Chemicals"]:::dsuse
    Solution["<b>Treatment solution</b><br>Object type: CHEMICAL<br>In: FB-Inventory<br>Space: MATERIALS<br>Project: CONSUMABLES<br>Collection: Chemicals"]:::dsuse
    Instrument1["<b>Instrument 1</b><br>Object type: INSTRUMENT<br>In: FB-Inventory<br>Space: EQUIPMENT<br>Project: INSTRUMENTS<br>Collection: Instruments"]:::dsuse
    Instrument2["<b>Instrument 2</b><br>Object type: INSTRUMENT<br>In: BAM-Inventory<br>Space: EQUIPMENT<br>Project: INSTRUMENTS<br>Collection: Instruments"]:::dsuse
    Instrument3["<b>Instrument 3</b><br>Object type: INSTRUMENT<br>In: BAM-Inventory<br>Space: EQUIPMENT<br>Project: INSTRUMENTS<br>Collection: Instruments"]:::dsuse

    Synthesized["<b>Synthesized material</b><br>Object type: SAMPLE<br>In: FB-Inventory<br>Space: MATERIALS<br>Project: MATERIALS<br>Collection: Samples"]:::dsmake
    Sample001["<b>Sample_001</b><br>Object type: SAMPLE<br>In: FB-Inventory<br>Space: MATERIALS<br>Project: MATERIALS<br>Collection: Samples"]:::dsmake

    DataSynthesis["<b>Material synthesis data</b><br>Dataset type: RAW_DATA"]:::dsdata
    DataChar1["<b>Characterization parameter 1 data</b><br>Dataset type: RAW_DATA"]:::dsdata
    DataChar2["<b>Characterization parameter 2 data</b><br>Dataset type: RAW_DATA"]:::dsdata
    DataAnalysis2["<b>Analysis of characterization parameter 2</b><br>Dataset type: ANALYZED_DATA"]:::dsdata

    Chemical1 -. "parent of" .-> Synthesis
    Chemical2 -. "parent of" .-> Synthesis
    Instrument1 -. "parent of" .-> Synthesis
    Synthesis -. "parent of" .-> Synthesized
    Synthesis -. "parent of" .-> Treatment
    Synthesized -. "parent of" .-> Sample001
    Sample001 -. "parent of" .-> Treatment
    Solution -. "parent of" .-> Treatment
    Treatment -. "parent of" .-> Char1
    Treatment -. "parent of" .-> Char2
    Instrument2 -. "parent of" .-> Char1
    Instrument3 -. "parent of" .-> Char2
    Char2 -. "parent of" .-> Analysis2
    Synthesis -. "has dataset" .-> DataSynthesis
    Char1 -. "has dataset" .-> DataChar1
    Char2 -. "has dataset" .-> DataChar2
    Analysis2 -. "has dataset" .-> DataAnalysis2

    classDef dsdo fill:#fff2cc,stroke:#d6b656,color:#0f172a
    classDef dsmake fill:#d5e8d4,stroke:#82b366,color:#0f172a
    classDef dsuse fill:#e1d5e7,stroke:#9673a6,color:#0f172a
    classDef dsdata fill:#f8cecc,stroke:#b85450,color:#0f172a

%% mermantics-kinds {"Synthesis":"step","Treatment":"step","Char1":"step","Char2":"step","Analysis2":"step","Chemical1":"chemical","Chemical2":"chemical","Solution":"chemical","Instrument1":"instrument","Instrument2":"instrument","Instrument3":"instrument","Synthesized":"sample","Sample001":"sample","DataSynthesis":"dataset","DataChar1":"dataset","DataChar2":"dataset","DataAnalysis2":"dataset"}
