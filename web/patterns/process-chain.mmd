%% Process chain: A process made of steps that follow each other, with a first and a last step, and an input and an output of the whole process.

    WholeProcess["<b>Whole process</b><br>COB_0000035 completely executed planned process"]:::local
    FirstStep["<b>First step</b><br>BFO_0000015 process"]:::local
    MiddleStep["<b>Middle step</b><br>BFO_0000015 process"]:::local
    LastStep["<b>Last step</b><br>BFO_0000015 process"]:::local
    StartingObject["<b>Starting object</b><br>BFO_0000030 object"]:::local
    Product["<b>Product</b><br>BFO_0000030 object"]:::local

    WholeProcess -. "starts with<br>RO_0002224" .-> FirstStep
    WholeProcess -. "ends with<br>RO_0002230" .-> LastStep
    WholeProcess -. "has proper occurrent part<br>BFO_0000118" .-> FirstStep
    WholeProcess -. "has proper occurrent part<br>BFO_0000118" .-> MiddleStep
    WholeProcess -. "has proper occurrent part<br>BFO_0000118" .-> LastStep
    FirstStep -. "precedes<br>BFO_0000063" .-> MiddleStep
    MiddleStep -. "precedes<br>BFO_0000063" .-> LastStep
    WholeProcess -. "has specified input<br>OBI_0000293" .-> StartingObject
    WholeProcess -. "has specified output<br>OBI_0000299" .-> Product

    classDef local fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#0f172a

