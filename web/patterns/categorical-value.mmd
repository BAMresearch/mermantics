%% Categorical value: A property of a material whose value is a category, not a number, for example a crystal structure (face-centred cubic) or an aggregate state (liquid).

    Material["<b>Material</b><br>PMD_0000000 material"]:::local
    Property["<b>Property</b><br>BFO_0000019 quality"]:::local
    Category["<b>Category</b><br>OBI_0001930 categorical value specification<br><br>e.g. face-centred cubic, liquid"]:::local

    Material -. "has quality<br>RO_0000086" .-> Property
    Property -. "specified by value<br>PMD_0000077" .-> Category

    classDef local fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px,color:#0f172a

