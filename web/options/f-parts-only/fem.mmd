    ElasticModel["<b>Linear elastic model</b><br>IAO_0000030 information content entity<br><br>is a: physics-based model"]:::proposed
    Balance["<b>Momentum balance</b><br>IAO_0000030 information content entity<br><br>is a: continuum physics equation"]:::proposed
    Hooke["<b>Hooke's law for the steel</b><br>IAO_0000030 information content entity<br><br>is a: materials relation"]:::proposed
    FEMethod["<b>Finite element method</b><br>PMD_0000931 simulation method specification<br><br>is a: numerical method<br>element type, mesh size"]:::proposed
    Mesh["<b>Mesh of the bracket, loads and supports</b><br>IAO_0000030 information content entity"]:::local
    Stress["<b>Stress and displacement fields</b><br>PMD_0025035 calculation datum"]:::local
    Code["<b>FE solver</b><br>IAO_0000010 software<br><br>name, version"]:::local
    Node["<b>Workstation</b><br>PMD_0000582 computing device"]:::local
